# Analytics and error reporting (#86). Copy to .env.local to try them
# locally; on Vercel, set them under Project → Settings → Environment
# Variables. Every one is optional: left unset, that service isn't loaded.

# Google Analytics 4: Admin → Data streams → your web stream → Measurement ID.
# Set it for Production only, so previews don't count as real visits.
VITE_GA4_MEASUREMENT_ID=

# Sentry, browser error reporting: Project → Settings → Client Keys (DSN).
# Safe to expose: it is sent to the browser.
VITE_SENTRY_DSN=

# Sentry source map upload, at build time only. Never exposed to the browser.
# SENTRY_AUTH_TOKEN is a secret: Settings → Auth Tokens (an organization
# token with the "project:releases" and "org:read" scopes).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
