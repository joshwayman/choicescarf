{
  // Config files, scripts and the data tests, which run in Node.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["vite.config.ts", "tests", "scripts", "src/data/**/*.test.ts"]
}
